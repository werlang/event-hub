<mj-section padding="0 24px 12px" background-color="#ffffff">
    <mj-column background-color="#f3f7f1" padding="18px" border="1px solid #dbe6d8" border-radius="16px">
        <mj-text font-size="11px" color="#5b775a" font-weight="bold" letter-spacing="1px" text-transform="uppercase" padding="0 0 6px">
            {{cardLabel}}
        </mj-text>
        <mj-text font-size="21px" color="#2f3b33" font-weight="bold" line-height="28px" padding="0 0 6px">
            {{eventTitle}}
        </mj-text>
        <mj-text font-size="13px" color="#6c7068" font-style="italic" padding="0 0 14px">
            {{actorText}}
        </mj-text>
        <mj-text font-size="15px" color="#5a6169" line-height="24px" padding="0 0 16px">
            {{eventDescription}}
        </mj-text>
        <mj-text font-size="11px" color="#5b775a" font-weight="bold" letter-spacing="1px" text-transform="uppercase" padding="0 0 4px">
            {{eventDateLabel}}
        </mj-text>
        <mj-text font-size="14px" color="#474c54" line-height="22px" padding="0 0 12px">
            {{eventDateValue}}
        </mj-text>
        <mj-text font-size="11px" color="#5b775a" font-weight="bold" letter-spacing="1px" text-transform="uppercase" padding="0 0 4px">
            {{locationLabel}}
        </mj-text>
        <mj-text font-size="14px" color="#474c54" line-height="22px" padding="0 0 12px">
            {{locationValue}}
        </mj-text>
        <mj-text font-size="11px" color="#5b775a" font-weight="bold" letter-spacing="1px" text-transform="uppercase" padding="0 0 4px">
            {{categoryLabel}}
        </mj-text>
        <mj-text font-size="14px" color="#474c54" line-height="22px" padding="0">
            {{categoryValue}}
        </mj-text>
    </mj-column>
</mj-section>