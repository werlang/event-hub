<mj-section padding="8px 20px" background-color="#ffffff">
    <mj-column background-color="#f8fafc" padding="16px" border="1px solid #dbe4f0" border-radius="12px">
        <mj-text font-size="18px" color="#0f172a" font-weight="bold" padding="0 0 8px">
            {{eventTitle}}
        </mj-text>
        <mj-text font-size="14px" color="#334155" padding="0 0 12px">
            {{eventDescription}}
        </mj-text>
        {{metaHtml}}
        {{calendarHtml}}
    </mj-column>
</mj-section>