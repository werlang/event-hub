<mj-section padding="8px 24px 8px" background-color="#ffffff">
    <mj-column>
        <mj-table width="100%" padding="0">
            <tr>
                <td style="border-top: 1px solid #d8dfd4; font-size: 0; line-height: 0; width: 24%;">&nbsp;</td>
                <td style="padding: 0 12px; color: #5b775a; font-size: 12px; font-weight: bold; letter-spacing: 0.8px; text-align: center; text-transform: uppercase; white-space: nowrap;">
                    {{separatorLabel}}
                </td>
                <td style="border-top: 1px solid #d8dfd4; font-size: 0; line-height: 0; width: 24%;">&nbsp;</td>
            </tr>
        </mj-table>
    </mj-column>
</mj-section>