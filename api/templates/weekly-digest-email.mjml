<mjml>
    <mj-head>
        <mj-title>{{emailTitle}}</mj-title>
        <mj-attributes>
            <mj-all font-family="Arial, sans-serif" />
        </mj-attributes>
    </mj-head>
    <mj-body background-color="#faf7f4">
        <mj-section background-color="#5b775a" padding="24px 20px">
            <mj-column>
                <mj-text font-size="24px" color="#ffffff" align="center" font-weight="bold">
                    {{emailTitle}}
                </mj-text>
                <mj-text font-size="14px" color="#f5fff4" align="center">
                    {{weekRangeLabel}}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="24px 20px 8px">
            <mj-column>
                <mj-text font-size="16px" color="#474c54" padding="0 0 10px">
                    {{greeting}}
                </mj-text>
                <mj-text font-size="14px" color="#474c54" padding="0 0 10px">
                    {{introText}}
                </mj-text>
                <mj-text font-size="13px" color="#474c54" padding="0 0 4px">
                    {{eventDescriptionText}}
                </mj-text>
            </mj-column>
        </mj-section>

        {{eventBlocks}}

        <mj-section background-color="#ffffff" padding="12px 20px 4px">
            <mj-column>
                <mj-text font-size="14px" color="#474c54" padding="0">
                    {{reviewText}}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="16px 20px 4px">
            <mj-column>
                <mj-button background-color="#542740" color="#ffffff" href="{{pageUrl}}" font-size="15px" padding="12px 18px" border-radius="6px">
                    {{pageButtonText}}
                </mj-button>
            </mj-column>
            <mj-column>
                <mj-button background-color="#542740" color="#ffffff" href="{{calendarUrl}}" font-size="15px" padding="12px 18px" border-radius="6px">
                    {{calendarButtonText}}
                </mj-button>
            </mj-column>
        </mj-section>

        <mj-section background-color="#faf7f4" padding="16px 20px">
            <mj-column>
                <mj-text font-size="12px" color="#542740" align="center">
                    {{footerText}}
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>