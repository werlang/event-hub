<mjml>
    <mj-head>
        <mj-title>{{emailTitle}}</mj-title>
        <mj-attributes>
            <mj-all font-family="Helvetica Neue, Arial, sans-serif" />
            <mj-text color="#474c54" line-height="1.6" />
            <mj-button font-weight="bold" inner-padding="14px 28px" border-radius="999px" />
        </mj-attributes>
    </mj-head>
    <mj-body background-color="#f5efe8" width="600px">
        <mj-section background-color="#f5efe8" padding="28px 20px 0">
            <mj-column>
                <mj-text align="center" font-size="11px" color="#7d6d63" font-weight="bold" letter-spacing="1.4px" text-transform="uppercase" padding="0 0 10px">
                    {{brandName}}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#5b775a" padding="26px 24px 24px" border-radius="28px 28px 0 0">
            <mj-column>
                <mj-text font-size="13px" color="#e3efe0" align="center" font-weight="bold" letter-spacing="1px" text-transform="uppercase" padding="0 0 8px">
                    {{eyebrowText}}
                </mj-text>
                <mj-text font-size="28px" color="#ffffff" align="center" font-weight="bold" line-height="1.25" padding="0">
                    {{emailTitle}}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="28px 24px 10px">
            <mj-column>
                <mj-text font-size="18px" color="#2f3b33" font-weight="bold" padding="0 0 10px">
                    {{greeting}}
                </mj-text>
                <mj-text font-size="15px" color="#5a6169" line-height="24px" padding="0">
                    {{introText}}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="6px 24px 4px">
            <mj-column>
                <mj-text font-size="15px" color="#5a6169" line-height="24px" padding="0">
                    {{reviewText}}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" padding="22px 24px 30px" border-radius="0 0 28px 28px">
            <mj-column>
                <mj-button background-color="#542740" color="#ffffff" href="{{actionUrl}}" font-size="15px" align="center">
                    {{buttonText}}
                </mj-button>
            </mj-column>
        </mj-section>

        <mj-section background-color="#f5efe8" padding="18px 20px 12px">
            <mj-column>
                <mj-text font-size="12px" color="#7d6d63" align="center">
                    {{footerText}}
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
